# ──────────────────────────────────────────────
# NexusAdmin — environment variables
# Copy to .env.local and fill in real values.
# ──────────────────────────────────────────────

# ── Database (Postgres) ──
# Supabase: postgresql://postgres.<ref>:<pwd>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Neon:     postgresql://<user>:<pwd>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/nexusadmin"
# Direct connection (no pgbouncer) — required by Prisma migrate on Supabase
DIRECT_URL="postgresql://user:password@localhost:5432/nexusadmin"

# ── NextAuth v5 ──
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# ── Google OAuth (optional) ──
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Vercel Blob (file uploads) ──
BLOB_READ_WRITE_TOKEN=""

# ── Resend (transactional email) ──
RESEND_API_KEY=""
EMAIL_FROM="NexusAdmin <noreply@yourdomain.com>"

# ── Stripe (payments) ──
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# ── App ──
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="NexusAdmin"
